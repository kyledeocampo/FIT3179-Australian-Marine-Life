{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Australian dolphin observations aggregated into hexagonal bins, coloured by dominant behaviour.",
  "width": 900,
  "height": 650,
  "padding": 0,
  "autosize": "none",
  "background": "#000000",

  "signals": [
    {"name": "hexWidth", "value": 16},
    {"name": "hexHeight", "update": "hexWidth * 0.8660254"},
    {"name": "hexSpacingX", "update": "hexWidth * 0.75"}
  ],

  "projections": [
    {
      "name": "projection",
      "type": "mercator",
      "center": [134, -27],
      "scale": 950,
      "translate": [450, 325],
      "clipExtent": [[0, 0], [900, 650]]
    }
  ],

  "data": [
    {
      "name": "countries",
      "url": "https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson",
      "format": {"type": "json", "property": "features"},
      "transform": [
        {"type": "filter", "expr": "datum.properties.ADMIN === 'Australia'"},
        {"type": "geoshape", "projection": "projection", "as": "shape"}
      ]
    },

    {
      "name": "observations",
      "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/data/AML%20-%20Australian%20Dolphin%20Behaviour.csv",
      "format": {
        "type": "csv",
        "parse": {"Latitude": "number", "Longitude": "number"}
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.Latitude) && isValid(datum.Longitude) && datum.Latitude >= -45 && datum.Latitude <= -8 && datum.Longitude >= 110 && datum.Longitude <= 155"
        },
        {
          "type": "formula",
          "as": "behaviour",
          "expr": "(isValid(datum.Behaviour) && trim(datum.Behaviour) !== '' && lower(trim(datum.Behaviour)) !== 'n/a') ? upper(substring(trim(datum.Behaviour), 0, 1)) + lower(substring(trim(datum.Behaviour), 1)) : 'Unknown'"
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["Longitude", "Latitude"],
          "as": ["px", "py"]
        },
        {"type": "filter", "expr": "isValid(datum.px) && isValid(datum.py)"},
        {"type": "formula", "as": "col", "expr": "round(datum.px / hexSpacingX)"},
        {
          "type": "formula",
          "as": "row",
          "expr": "round((datum.py - (abs(datum.col) % 2) * hexHeight / 2) / hexHeight)"
        }
      ]
    },

    {
      "name": "binBehaviour",
      "source": "observations",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["col", "row", "behaviour"],
          "ops": ["count"],
          "as": ["n"]
        },
        {
          "type": "formula",
          "as": "weight",
          "expr": "datum.n + (datum.behaviour === 'Unknown' ? 0 : 0.5)"
        }
      ]
    },

    {
      "name": "hexBins",
      "source": "binBehaviour",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["col", "row"],
          "ops": ["sum", "argmax"],
          "fields": ["n", "weight"],
          "as": ["total", "top"]
        },
        {"type": "formula", "as": "dominant", "expr": "datum.top.behaviour"},
        {"type": "formula", "as": "dominantCount", "expr": "datum.top.n"},
        {"type": "formula", "as": "cx", "expr": "datum.col * hexSpacingX"},
        {
          "type": "formula",
          "as": "cy",
          "expr": "datum.row * hexHeight + (abs(datum.col) % 2) * hexHeight / 2"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "behaviourColor",
      "type": "ordinal",
      "domain": ["Travelling", "Feeding", "Socialising", "Milling", "Resting", "Deceased", "Unknown"],
      "range": ["#2ec4ff", "#ff9f1c", "#ff3d9a", "#7bd957", "#a77bff", "#ff3b30", "#8a9099"]
    },
    {
      "name": "countOpacity",
      "type": "sqrt",
      "domain": {"data": "hexBins", "field": "total"},
      "range": [0.55, 1],
      "clamp": true
    }
  ],

  "legends": [
    {
      "fill": "behaviourColor",
      "title": "Dominant behaviour",
      "orient": "bottom-left",
      "offset": 20,
      "symbolType": "square",
      "symbolSize": 140,
      "titleColor": "#ffffff",
      "labelColor": "#ffffff"
    },
    {
      "opacity": "countOpacity",
      "title": "Observations in bin",
      "orient": "bottom-right",
      "offset": 20,
      "values": [1, 3, 6, 10],
      "symbolType": "square",
      "symbolSize": 140,
      "titleColor": "#ffffff",
      "labelColor": "#ffffff",
      "encode": {
        "symbols": {"update": {"fill": {"value": "#cccccc"}, "stroke": {"value": "transparent"}}}
      }
    }
  ],

  "marks": [
    {
      "type": "shape",
      "name": "australia",
      "from": {"data": "countries"},
      "encode": {
        "update": {
          "shape": {"field": "shape"},
          "fill": {"value": "#1a1a1a"},
          "stroke": {"value": "#555555"},
          "strokeWidth": {"value": 0.8}
        }
      }
    },

    {
      "type": "symbol",
      "name": "hexagonBins",
      "from": {"data": "hexBins"},
      "encode": {
        "update": {
          "x": {"field": "cx"},
          "y": {"field": "cy"},
          "shape": {"value": "M1,0L0.5,0.8660254L-0.5,0.8660254L-1,0L-0.5,-0.8660254L0.5,-0.8660254Z"},
          "size": {"signal": "hexWidth * hexWidth * 0.92"},
          "fill": {"scale": "behaviourColor", "field": "dominant"},
          "fillOpacity": {"scale": "countOpacity", "field": "total"},
          "stroke": {"value": "#000000"},
          "strokeWidth": {"value": 0.5},
          "tooltip": {
            "signal": "{'Dominant behaviour': datum.dominant, 'Observations in bin': datum.total, 'Of which dominant': datum.dominantCount}"
          }
        }
      }
    }
  ]
}
