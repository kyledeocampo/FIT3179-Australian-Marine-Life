{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Total Australian dolphin sightings over time, with a toggle for species breakdown.",
  "data": {
    "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/data/AML%20-%20Australian%20Dolphin%20Sightings%20over%20time%20by%20Species.csv",
    "format": { "type": "csv" }
  },
  "params": [
    {
      "name": "viewMode",
      "value": "Total sightings",
      "bind": {
        "input": "select",
        "options": ["Total sightings", "Sightings by species"],
        "name": "View: "
      }
    }
  ],
  "transform": [
    {
      "filter": "isValid(datum.Year) && datum.Year != 'n.d.' && datum.Year != '' && isValid(datum.Species) && datum.Species != ''"
    },
    { "calculate": "toNumber(datum.Year)", "as": "YearNumeric" },
    { "filter": "isValid(datum.YearNumeric)" },
    {
      "filter": "viewMode === 'Total sightings' || (indexof(datum.Species, 'Dolphin') >= 0 && indexof(datum.Species, 'Mixed') < 0)"
    },
    {
      "calculate": "viewMode === 'Total sightings' ? 'All species' : datum.Species",
      "as": "SpeciesGroup"
    },
    {
      "aggregate": [{ "op": "count", "as": "TotalSightings" }],
      "groupby": ["YearNumeric", "SpeciesGroup"]
    },
    {
      "window": [{ "op": "row_number", "as": "SpeciesIndex" }],
      "sort": [{ "field": "SpeciesGroup", "order": "ascending" }],
      "groupby": ["YearNumeric"]
    },
    {
      "joinaggregate": [{ "op": "count", "as": "SpeciesCount" }],
      "groupby": ["YearNumeric"]
    },
    {
      "calculate": "datum.YearNumeric + (datum.SpeciesIndex - (datum.SpeciesCount + 1) / 2) * 0.08",
      "as": "PlotYear"
    }
  ],
  "width": "container",
  "height": 450,
  "encoding": {
    "x": {
      "field": "PlotYear",
      "type": "quantitative",
      "title": "Year",
      "scale": { "domain": [2017.5, 2024.5], "nice": false },
      "axis": {
        "values": [2018, 2019, 2020, 2021, 2022, 2023, 2024],
        "format": "d",
        "grid": false
      }
    },
    "y": {
      "field": "TotalSightings",
      "type": "quantitative",
      "title": "Total Dolphin Sightings",
      "scale": { "zero": true }
    },
    "color": {
      "condition": {
        "test": "viewMode === 'Total sightings'",
        "value": "#087E8B"
      },
      "field": "SpeciesGroup",
      "type": "nominal",
      "scale": { "scheme": "tableau20" },
      "legend": null
    },
    "tooltip": [
      { "field": "YearNumeric", "type": "quantitative", "title": "Year", "format": "d" },
      { "field": "SpeciesGroup", "type": "nominal", "title": "Species" },
      { "field": "TotalSightings", "type": "quantitative", "title": "Total Sightings", "format": "," }
    ]
  },
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 2, "strokeCap": "round", "opacity": 0.85 },
      "encoding": { "y2": { "datum": 0 } }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70,
        "stroke": "white",
        "strokeWidth": 1,
        "opacity": 1
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "gridColor": "#E5E5E5",
      "gridOpacity": 0.7
    }
  }
}