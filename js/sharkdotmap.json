{
    "$schema": "https://vega.github.io/schema/vega/v6.json",
    "description": "Australian shark incidents as a dot map, coloured by shark species.",
    "width": 1000,
    "height": 700,
    "padding": 0,
    "autosize": "none",
    "background": "#ffffff",
  
    "signals": [
      {"name": "dotSize", "value": 45}
    ],
  
    "projections": [
      {
        "name": "projection",
        "type": "mercator",
        "center": [134, -27],
        "scale": 950,
        "translate": [450, 325],
        "clipExtent": [[0, 0], [900, 650]]
      }
    ],
  
    "data": [
      {
        "name": "countries",
        "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/js/ne_50m_countries_states.json",
        "format": { "type": "topojson", "feature": "ne_50m_admin_0_countries" }
      },
      {
        "name": "states",
        "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/js/ne_50m_countries_states.json",
        "format": { "type": "topojson", "feature": "ne_50m_admin_1_states_provinces" }
      },
      {
        "name": "incidents",
        "url": "data/AML%20-%20Australian%20Shark-Incident%20Database%20Public%20Version.csv",
        "format": {
          "type": "csv",
          "parse": {"Latitude": "number", "Longitude": "number", "Incident.year": "number"}
        },
        "transform": [
          {
            "type": "filter",
            "expr": "isValid(datum.Latitude) && isValid(datum.Longitude) && datum.Latitude >= -45 && datum.Latitude <= -8 && datum.Longitude >= 110 && datum.Longitude <= 155"
          },
          {
            "type": "formula",
            "as": "sp",
            "expr": "isValid(datum['Shark.common.name']) ? lower(trim(datum['Shark.common.name'])) : ''"
          },
          {
            "type": "formula",
            "as": "species",
            "expr": "datum.sp === 'white shark' ? 'White shark' : datum.sp === 'tiger shark' ? 'Tiger shark' : datum.sp === 'bull shark' ? 'Bull shark' : datum.sp === 'wobbegong' ? 'Wobbegong' : (datum.sp === 'whaler shark' || datum.sp === 'bronze whaler shark') ? 'Whaler shark' : (datum.sp === '' || datum.sp === 'unknown') ? 'Unknown' : 'Other species'"
          },
          {
            "type": "formula",
            "as": "drawOrder",
            "expr": "datum.species === 'Unknown' ? 0 : datum.species === 'Other species' ? 1 : 2"
          },
          {"type": "collect", "sort": {"field": "drawOrder"}},
          {
            "type": "geopoint",
            "projection": "projection",
            "fields": ["Longitude", "Latitude"],
            "as": ["px", "py"]
          },
          {"type": "filter", "expr": "isValid(datum.px) && isValid(datum.py)"}
        ]
      }
    ],
  
    "scales": [
      {
        "name": "speciesColor",
        "type": "ordinal",
        "domain": ["White shark", "Tiger shark", "Bull shark", "Wobbegong", "Whaler shark", "Other species", "Unknown"],
        "range": ["#2ec4ff", "#ff9f1c", "#ff3d9a", "#7bd957", "#a77bff", "#ffe14d", "#8a9099"]
      }
    ],
  
    "legends": [
      {
        "fill": "speciesColor",
        "title": "Shark species",
        "orient": "bottom-left",
        "offset": 10,
        "symbolType": "circle",
        "symbolSize": 140,
        "titleColor": "#000000",
        "titleFontSize":24,
        "labelFontSize":24,
        "labelColor": "#000000"
      }
    ],
  
    "marks": [
      {
        "type": "shape",
        "name": "land",
        "from": { "data": "countries" },
        "encode": {
          "update": {
            "fill": { "value": "#ffffff" },
            "stroke": { "value": "#000000" },
            "strokeWidth": { "value": 0.8 }
          }
        },
        "transform": [{ "type": "geoshape", "projection": "projection" }]
      },
      {
        "type": "shape",
        "name": "landstate",
        "from": { "data": "states" },
        "encode": {
          "update": {
            "fill": { "value": null },
            "stroke": { "value": "#000000" },
            "strokeWidth": { "value": 0.3 }
          }
        },
        "transform": [{ "type": "geoshape", "projection": "projection" }]
      },
      {
        "type": "symbol",
        "name": "incidentDots",
        "from": {"data": "incidents"},
        "encode": {
          "update": {
            "x": {"field": "px"},
            "y": {"field": "py"},
            "shape": {"value": "circle"},
            "size": {"signal": "dotSize"},
            "fill": {"scale": "speciesColor", "field": "species"},
            "fillOpacity": {"value": 0.75},
            "stroke": {"value": "#000000"},
            "strokeWidth": {"value": 0.4},
            "tooltip": {
              "signal": "{'Species': datum.species, 'Recorded year': datum['Incident.year'], 'Location': datum.Location, 'Result of incident': datum['Victim.injury']}"
            }
          },
          "hover": {
            "stroke": {"value": "#ffffff"},
            "strokeWidth": {"value": 1.5},
            "fillOpacity": {"value": 1}
          }
        }
      }
    ]
  }