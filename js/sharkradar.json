{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Radar chart comparing shark species and specifications.",
  "padding": 10,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "signals": [
    {
      "name": "width",
      "init": "containerSize()[0] > 50 ? containerSize()[0] : 500",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[0] > 50 ? containerSize()[0] : 500"
        }
      ]
    },
    {
      "name": "height",
      "init": "containerSize()[1] > 50 ? containerSize()[1] : 500",
      "on": [
        {
          "events": "window:resize",
          "update": "containerSize()[1] > 50 ? containerSize()[1] : 500"
        }
      ]
    },
    {
      "name": "barHeight",
      "value": 50
    },
    {
      "name": "radius",
      "update": "max(50, min((height - barHeight) / 2 - 40, (width / 2 - 125) / 0.71 - 18))"
    },
    {
      "name": "centerX",
      "update": "width / 2"
    },
    {
      "name": "centerY",
      "update": "(height - barHeight) / 2"
    },
    {
      "name": "barWidth",
      "update": "min(width - 40, 560)"
    },
    {
      "name": "barLeft",
      "update": "(width - barWidth) / 2"
    },
    {
      "name": "barTop",
      "update": "height - 36"
    }
  ],
  "data": [
    {
      "name": "raw",
      "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/data/AML%20-%20Radar%20Chart%20Shark%20Species%20and%20Specifications.csv",
      "format": {
        "type": "csv"
      }
    },
    {
      "name": "table",
      "source": "raw",
      "transform": [
        {
          "type": "fold",
          "fields": ["Length", "Weight", "Lifespan", "Conservation Status"],
          "as": ["metric", "value"]
        },
        {
          "type": "formula",
          "as": "metricOrder",
          "expr": "datum.metric === 'Length' ? 0 : datum.metric === 'Weight' ? 1 : datum.metric === 'Lifespan' ? 2 : 3"
        },
        {
          "type": "formula",
          "as": "normalised",
          "expr": "datum.metric === 'Length' ? (toNumber(datum.value) - 3) / 3 : datum.metric === 'Weight' ? (toNumber(datum.value) - 70) / 1830 : datum.metric === 'Lifespan' ? (toNumber(datum.value) - 22) / 48 : (toNumber(datum.value) - 1) / 6"
        },
        {
          "type": "formula",
          "as": "display",
          "expr": "datum.metric === 'Length' ? datum.value + ' m' : datum.metric === 'Weight' ? datum.value + ' kg' : datum.metric === 'Lifespan' ? datum.value + ' Years' : '' + datum.value"
        },
        {
          "type": "filter",
          "expr": "isValid(toNumber(datum.value))"
        },
        {
          "type": "collect",
          "sort": {
            "field": ["Species", "metricOrder"],
            "order": ["ascending", "ascending"]
          }
        }
      ]
    },
    {
      "name": "metrics",
      "source": "table",
      "transform": [
        {
          "type": "aggregate",
          "groupby": ["metric", "metricOrder"]
        },
        {
          "type": "collect",
          "sort": {
            "field": "metricOrder",
            "order": "ascending"
          }
        }
      ]
    },
    {
      "name": "rings",
      "values": [
        {"level": 0.33},
        {"level": 0.66},
        {"level": 1.0}
      ]
    },
    {
      "name": "status",
      "values": [
        {"code": "LC", "num": 1, "color": "#60C659"},
        {"code": "NT", "num": 2, "color": "#CCE226"},
        {"code": "VU", "num": 3, "color": "#F9E814"},
        {"code": "EN", "num": 4, "color": "#FC7F3F"},
        {"code": "CR", "num": 5, "color": "#D81E05"},
        {"code": "EW", "num": 6, "color": "#542344"},
        {"code": "EX", "num": 7, "color": "#000000"}
      ]
    }
  ],
  "scales": [
    {
      "name": "angular",
      "type": "point",
      "domain": {
        "data": "metrics",
        "field": "metric"
      },
      "range": {
        "signal": "[0, 2 * PI]"
      },
      "padding": 0.5
    },
    {
      "name": "radial",
      "type": "linear",
      "domain": [0, 1],
      "range": [0, {"signal": "radius"}],
      "clamp": true,
      "nice": false
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "raw",
        "field": "Species"
      },
      "range": {
        "scheme": "category10"
      }
    },
    {
      "name": "statusX",
      "type": "band",
      "domain": {
        "data": "status",
        "field": "code"
      },
      "range": [0, {"signal": "barWidth"}],
      "padding": 0
    }
  ],
  "legends": [
    {
      "fill": "color",
      "title": "Species",
      "orient": "top-left",
      "direction": "vertical",
      "symbolType": "circle",
      "symbolSize": 100,
      "titleFontSize": 12,
      "labelFontSize": 11,
      "offset": 0
    }
  ],
  "marks": [
    {
      "type": "group",
      "name": "radar",
      "encode": {
        "update": {
          "x": {"signal": "centerX"},
          "y": {"signal": "centerY"},
          "width": {"value": 0},
          "height": {"value": 0}
        }
      },
      "marks": [
        {
          "type": "symbol",
          "name": "grid-rings",
          "from": {"data": "rings"},
          "encode": {
            "update": {
              "x": {"value": 0},
              "y": {"value": 0},
              "shape": {"value": "circle"},
              "size": {
                "signal": "pow(scale('radial', datum.level), 2) * PI"
              },
              "fill": {"value": "white"},
              "fillOpacity": {"value": 0},
              "stroke": {"value": "black"},
              "strokeWidth": {"value": 1}
            }
          }
        },
        {
          "type": "rule",
          "name": "radial-axes",
          "from": {"data": "metrics"},
          "encode": {
            "update": {
              "x": {"value": 0},
              "y": {"value": 0},
              "x2": {
                "signal": "scale('radial', 1) * cos(scale('angular', datum.metric) - PI / 2)"
              },
              "y2": {
                "signal": "scale('radial', 1) * sin(scale('angular', datum.metric) - PI / 2)"
              },
              "stroke": {"value": "#94a3b8"},
              "strokeWidth": {"value": 1}
            }
          }
        },
        {
          "type": "group",
          "name": "species-groups",
          "from": {
            "facet": {
              "data": "table",
              "name": "speciesData",
              "groupby": ["Species"]
            }
          },
          "marks": [
            {
              "type": "line",
              "name": "species-polygon",
              "from": {"data": "speciesData"},
              "sort": {
                "field": "metricOrder",
                "order": "ascending"
              },
              "encode": {
                "update": {
                  "x": {
                    "signal": "scale('radial', datum.normalised) * cos(scale('angular', datum.metric) - PI / 2)"
                  },
                  "y": {
                    "signal": "scale('radial', datum.normalised) * sin(scale('angular', datum.metric) - PI / 2)"
                  },
                  "stroke": {"scale": "color", "field": "Species"},
                  "strokeWidth": {"value": 2.5},
                  "fill": {"scale": "color", "field": "Species"},
                  "fillOpacity": {"value": 0.15},
                  "interpolate": {"value": "linear-closed"}
                }
              }
            },
            {
              "type": "symbol",
              "name": "species-points",
              "from": {"data": "speciesData"},
              "encode": {
                "enter": {
                  "cursor": {"value": "pointer"}
                },
                "update": {
                  "x": {
                    "signal": "scale('radial', datum.normalised) * cos(scale('angular', datum.metric) - PI / 2)"
                  },
                  "y": {
                    "signal": "scale('radial', datum.normalised) * sin(scale('angular', datum.metric) - PI / 2)"
                  },
                  "size": {"value": 80},
                  "fill": {"scale": "color", "field": "Species"},
                  "stroke": {"value": "white"},
                  "strokeWidth": {"value": 1},
                  "tooltip": {
                    "signal": "{'Species': datum.Species, 'Metric': datum.metric, 'Value': datum.display}"
                  }
                },
                "hover": {
                  "size": {"value": 160},
                  "strokeWidth": {"value": 2}
                }
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "metric-labels",
          "from": {"data": "metrics"},
          "encode": {
            "update": {
              "x": {
                "signal": "(radius + 18) * cos(scale('angular', datum.metric) - PI / 2)"
              },
              "y": {
                "signal": "(radius + 18) * sin(scale('angular', datum.metric) - PI / 2)"
              },
              "text": {"field": "metric"},
              "fontSize": {"value": 12},
              "fontWeight": {"value": "bold"},
              "fill": {"value": "#1f2937"},
              "align": {
                "signal": "cos(scale('angular', datum.metric) - PI / 2) > 0.2 ? 'left' : cos(scale('angular', datum.metric) - PI / 2) < -0.2 ? 'right' : 'center'"
              },
              "baseline": {
                "signal": "sin(scale('angular', datum.metric) - PI / 2) > 0.2 ? 'top' : sin(scale('angular', datum.metric) - PI / 2) < -0.2 ? 'bottom' : 'middle'"
              }
            }
          }
        }
      ]
    },
    {
      "type": "rect",
      "name": "status-bar",
      "from": {"data": "status"},
      "encode": {
        "update": {
          "x": {"signal": "barLeft + scale('statusX', datum.code)"},
          "width": {"signal": "bandwidth('statusX')"},
          "y": {"signal": "barTop"},
          "height": {"value": 14},
          "fill": {"field": "color"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1}
        }
      }
    },
    {
      "type": "text",
      "name": "status-numbers",
      "from": {"data": "status"},
      "encode": {
        "update": {
          "x": {"signal": "barLeft + scale('statusX', datum.code) + bandwidth('statusX') / 2"},
          "y": {"signal": "barTop - 4"},
          "text": {"field": "num"},
          "align": {"value": "center"},
          "baseline": {"value": "bottom"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#1f2937"}
        }
      }
    },
    {
      "type": "text",
      "name": "status-labels",
      "from": {"data": "status"},
      "encode": {
        "update": {
          "x": {"signal": "barLeft + scale('statusX', datum.code) + bandwidth('statusX') / 2"},
          "y": {"signal": "barTop + 18"},
          "text": {"field": "code"},
          "align": {"value": "center"},
          "baseline": {"value": "top"},
          "fontSize": {"value": 12},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#1f2937"}
        }
      }
    }
  ]
}