
{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "width": 1000,
    "height": 650,
    "padding": 30,
    "autosize": "fit",
  
    "data": [
      {
        "name": "table",
        "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/data/AML%20-%20Whale%20Sizes%20and%20Lengths%20Pictogram%20Comparison.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Length (m)": "number",
            "Height (m)": "number",
            "Weight (metric tons)": "number"
          }
        },
        "transform": [
          {
            "type": "filter",
            "expr": "isValid(datum['Length (m)']) && isValid(datum['Height (m)']) && isValid(datum['Weight (metric tons)'])"
          },
          {
            "type": "formula",
            "as": "ImageWidth",
            "expr": "datum['Length (m)']"
          },
          {
            "type": "formula",
            "as": "ImageHeight",
            "expr": "datum['Height (m)']"
          },
          {
            "type": "formula",
            "as": "WeightSaturation",
            "expr": "0.2 + 0.8 * datum['Weight (metric tons)'] / 200"
          }
        ]
      }
    ],
  
    "signals": [
      {"name": "baseline", "value": 510}
    ],
  
    "scales": [
      {
        "name": "x",
        "type": "band",
        "domain": {"data": "table", "field": "Species"},
        "range": [10, 990],
        "padding": 0.08
      },
      {
        "name": "weightColor",
        "type": "linear",
        "domain": [0, 200],
        "range": ["#e5e5e5", "#263746"],
        "clamp": true
      }
    ],
  
    "marks": [
      {
        "type": "rule",
        "encode": {
          "enter": {
            "x": {"value": 0},
            "x2": {"signal": "width"},
            "y": {"signal": "baseline"},
            "stroke": {"value": "#d5d5d5"},
            "strokeWidth": {"value": 1}
          }
        }
      },
      {
        "type": "image",
        "name": "comparisonImages",
        "from": {"data": "table"},
        "encode": {
          "enter": {
            "url": {"field": "url"},
            "align": {"value": "center"},
            "baseline": {"value": "bottom"},
            "aspect": {"value": true}
          },
          "update": {
            "x": {
              "scale": "x",
              "field": "Species",
              "band": 0.5
            },
            "y": {"signal": "baseline"},
            "width": {
            "signal": "datum['Length (m)'] * 20"
            },
            "height": {
            "signal": "datum['Height (m)'] * 65"
            },
            "opacity": {
              "signal": "0.35 + 0.65 * datum['Weight (metric tons)'] / 200"
            },
            "tooltip": {
              "signal": "{'Species': datum.Species, 'Length (m)': datum['Length (m)'], 'Height (m)': datum['Height (m)'], 'Weight (metric tons)': datum['Weight (metric tons)']}"
            }
          }
        }
      },
      {
        "type": "text",
        "from": {"data": "table"},
        "encode": {
          "enter": {
            "align": {"value": "center"},
            "baseline": {"value": "top"},
            "fontSize": {"value": 13},
            "fill": {"value": "#263746"}
          },
          "update": {
            "x": {
              "scale": "x",
              "field": "Species",
              "band": 0.5
            },
            "y": {"signal": "baseline + 12"},
            "text": {"field": "Species"},
            "limit": {"value": 150}
          }
        }
      }
    ]
  }
  