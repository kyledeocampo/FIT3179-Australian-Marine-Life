
{
    "$schema": "https://vega.github.io/schema/vega/v5.json",
    "width": 700,
    "height": 700,
    "padding": 20,
    "autosize": "fit",
  
    "data": [
      {
        "name": "table",
        "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/data/AML%20-%20Current%20Population%20of%20Whale%20Species%20in%20Australia.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Species": "string",
            "Length (m)": "number",
            "Height (m)": "number",
            "Weight (metric tons)": "number"
          }
        },
        "transform": [
          {
            "type": "filter",
            "expr": "isValid(datum['Length (m)']) && isValid(datum['Height (m)']) && datum['Length (m)'] > 0 && datum['Height (m)'] > 0"
          },
          {
            "type": "formula",
            "as": "Image",
            "expr": "'https://cdn.jsdelivr.net/gh/twitter/twemoji@latest/assets/svg/1f40b.svg'"
          }
        ]
      }
    ],
  
    "signals": [
      {"name": "baseline", "value": 590},
      {"name": "maxImageHeight", "value": 420},
      {"name": "maxImageWidth", "value": 180}
    ],
  
    "scales": [
      {
        "name": "x",
        "type": "band",
        "domain": {
          "data": "table",
          "field": "Species"
        },
        "range": [20, 680],
        "padding": 0.12
      },
      {
        "name": "heightScale",
        "type": "linear",
        "domain": {
          "data": "table",
          "field": "Height (m)"
        },
        "range": [60, 420],
        "zero": false,
        "nice": false
      },
      {
        "name": "lengthScale",
        "type": "linear",
        "domain": {
          "data": "table",
          "field": "Length (m)"
        },
        "range": [60, 180],
        "zero": false,
        "nice": false
      }
    ],
  
    "marks": [
      {
        "type": "rule",
        "encode": {
          "enter": {
            "x": {"value": 15},
            "x2": {"value": 685},
            "y": {"signal": "baseline"},
            "stroke": {"value": "#aab3bd"},
            "strokeWidth": {"value": 1}
          }
        }
      },
      {
        "type": "image",
        "name": "whaleImages",
        "from": {"data": "table"},
        "encode": {
          "enter": {
            "url": {"field": "Image"},
            "align": {"value": "center"},
            "baseline": {"value": "bottom"},
            "aspect": {"value": true}
          },
          "update": {
            "x": {
              "scale": "x",
              "field": "Species",
              "band": 0.5
            },
            "y": {"signal": "baseline"},
            "height": {
              "scale": "heightScale",
              "field": "Height (m)"
            },
            "width": {
              "signal": "scale('heightScale', datum['Height (m)']) * datum['Length (m)'] / datum['Height (m)']"
            },
            "tooltip": {
              "signal": "{'Species': datum.Species, 'Length (m)': format(datum['Length (m)'], '.2f'), 'Height (m)': format(datum['Height (m)'], '.2f'), 'Weight (metric tons)': datum['Weight (metric tons)']}"
            }
          }
        }
      },
      {
        "type": "text",
        "from": {"data": "table"},
        "encode": {
          "enter": {
            "align": {"value": "center"},
            "baseline": {"value": "top"},
            "fontSize": {"value": 12},
            "fill": {"value": "#253448"}
          },
          "update": {
            "x": {
              "scale": "x",
              "field": "Species",
              "band": 0.5
            },
            "y": {"signal": "baseline + 8"},
            "text": {"field": "Species"}
          }
        }
      }
    ]
  }
  