
{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 700,
  "height": 700,
  "padding": 0,
  "autosize": "none",

  "signals": [
    {"name": "startAngle", "value": -3.14},
    {"name": "endAngle", "value": 1.552},
    {"name": "padAngle", "value": 0},
    {"name": "bandPadding", "value": 0.15},
    {"name": "innerRadius", "value": 60},
    {"name": "cornerRadius", "value": 0}
  ],

  "data": [
    {
      "name": "table",
      "url": "https://raw.githubusercontent.com/kyledeocampo/FIT3179-Australian-Marine-Life/refs/heads/main/data/AML%20-%20Current%20Population%20of%20Whale%20Species%20in%20Australia.csv",      
      "format":{
        "type": "csv",
        "parse": {
          "Name": "string",
          "Population": "number"
        }
      }
    }
  ],

  "scales": [
    {
      "name": "radius",
      "type": "band",
      "domain": {
        "data": "table",
        "field": "Name"
      },
      "range": [
        {"signal": "innerRadius"},
        {"signal": "width / 2 - 20"}
      ],
      "paddingInner": {"signal": "bandPadding"},
      "paddingOuter": 0
    },
    {
      "name": "population",
      "type": "linear",
      "domain": [0, 96000],
      "range": [
        {"signal": "startAngle"},
        {"signal": "endAngle"}
      ],
      "zero": true,
      "nice": false
    }
  ],

  "marks": [
    {
      "type": "arc",
      "name": "backgroundRings",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"signal": "width / 2"},
          "y": {"signal": "height / 2"},
          "fill": {"value": "#cccccc"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 2}
        },
        "update": {
          "startAngle": {"signal": "startAngle"},
          "endAngle": {"signal": "endAngle"},
          "innerRadius": {"scale": "radius", "field": "Name"},
          "outerRadius": {
            "scale": "radius",
            "field": "Name",
            "band": 1
          },
          "padAngle": {"signal": "padAngle"},
          "cornerRadius": {"signal": "cornerRadius"}
        }
      }
    },
    {
      "type": "arc",
      "name": "populationBars",
      "from": {"data": "table"},
      "encode": {
        "enter": {
          "x": {"signal": "width / 2"},
          "y": {"signal": "height / 2"},
          "stroke": {"value": "white"},
          "strokeWidth": {"value": 1},
          "tooltip": {
            "signal": "{'Whale species': datum.Name, 'Population': format(datum.Population, ',')}"
          }
        },
        "update": {
          "fill": {
            "signal": "datum.Population < 1000 ? '#ff0000' : '#008000'"
          },
          "startAngle": {"signal": "startAngle"},
          "endAngle": {
            "scale": "population",
            "field": "Population"
          },
          "innerRadius": {"scale": "radius", "field": "Name"},
          "outerRadius": {
            "scale": "radius",
            "field": "Name",
            "band": 1
          },
          "padAngle": {"signal": "padAngle"},
          "cornerRadius": {"signal": "cornerRadius"}
        },
        "hover": {
          "stroke": {"value": "#222222"},
          "strokeWidth": {"value": 2}
        }
      }
    },
    {
      "type": "text",
      "name": "barLabels",
      "from": {"data": "table"},
      "interactive": false,
      "encode": {
        "enter": {
          "text": {"field": "Name"},
          "align": {"value": "left"},
          "baseline": {"value": "middle"},
          "fill": {"value": "#000000"},
          "fontSize": {"value": 14},
          "fontWeight": {"value": "bold"}
        },
        "update": {
          "x": {
            "signal": "width / 2 + (scale('radius', datum.Name) + bandwidth('radius') / 2) * sin(startAngle) + 6"
          },
          "y": {
            "signal": "height / 2 - (scale('radius', datum.Name) + bandwidth('radius') / 2) * cos(startAngle)"
          }
        }
      }
    }
  ]
}
